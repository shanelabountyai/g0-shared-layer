{
  "capability": "evaluation",
  "tool": "evaluation",
  "version": "1",
  "description": "Score an item against a seeded rubric (`post_angle_v1`, `claim_rule_v1`, `digest_item_v1`). `item` is a string or an object; `context` is the source material the item must be faithful to (needed for `claim_rule_v1`). `judge`: `auto` (Claude when a key is present, else deterministic), `deterministic`, `claude`, `fixture`. Returns a score per criterion, pass/fail and notes, plus tokens and cost when a model was used. A model judge is capped by the run's cost cap.",
  "input": {
    "properties": {
      "version": {
        "const": "1",
        "default": "1",
        "title": "Version",
        "type": "string"
      },
      "rubric_id": {
        "minLength": 1,
        "title": "Rubric Id",
        "type": "string"
      },
      "item": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": true,
            "type": "object"
          }
        ],
        "description": "The thing to score: text, or an object with named fields.",
        "title": "Item"
      },
      "context": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Source material the item must stay faithful to.",
        "title": "Context"
      },
      "judge": {
        "default": "auto",
        "enum": [
          "auto",
          "deterministic",
          "claude",
          "fixture"
        ],
        "title": "Judge",
        "type": "string"
      },
      "run_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Run to log any model call under (observability).",
        "title": "Run Id"
      }
    },
    "required": [
      "rubric_id",
      "item"
    ],
    "title": "evaluationArguments",
    "type": "object"
  },
  "output": {
    "$defs": {
      "CriterionScore": {
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "title": "Criterion",
            "type": "string"
          },
          "score": {
            "maximum": 1,
            "minimum": 0,
            "title": "Score",
            "type": "number"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "note": {
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "criterion",
          "score",
          "weight",
          "required",
          "note"
        ],
        "title": "CriterionScore",
        "type": "object"
      },
      "NextStep": {
        "additionalProperties": false,
        "description": "What to do next. Absent when the caller cannot fix it alone.",
        "properties": {
          "tool": {
            "description": "Tool to call next.",
            "title": "Tool",
            "type": "string"
          },
          "why": {
            "description": "What calling it will get you.",
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "why"
        ],
        "title": "NextStep",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "description": "The envelope. `message` is plain words a model can show a human as-is.",
        "properties": {
          "code": {
            "enum": [
              "INVALID_ARGUMENT",
              "NOT_FOUND",
              "UNKNOWN_RUBRIC",
              "UNKNOWN_POLICY",
              "JUDGE_UNAVAILABLE",
              "OVER_CAP",
              "STORAGE_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Which input argument to change, when one is.",
            "title": "Field"
          },
          "next": {
            "anyOf": [
              {
                "$ref": "#/$defs/NextStep"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      },
      "Usage": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "input_tokens": {
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "title": "Output Tokens",
            "type": "integer"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          }
        },
        "required": [
          "model",
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "title": "Usage",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "version": {
        "const": "1",
        "default": "1",
        "title": "Version",
        "type": "string"
      },
      "capability": {
        "const": "evaluation",
        "default": "evaluation",
        "title": "Capability",
        "type": "string"
      },
      "ok": {
        "default": true,
        "title": "Ok",
        "type": "boolean"
      },
      "error": {
        "anyOf": [
          {
            "$ref": "#/$defs/ToolError"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "evaluation_id": {
        "default": "",
        "title": "Evaluation Id",
        "type": "string"
      },
      "rubric_id": {
        "default": "",
        "title": "Rubric Id",
        "type": "string"
      },
      "judge": {
        "anyOf": [
          {
            "enum": [
              "deterministic",
              "claude",
              "fixture"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Judge"
      },
      "scores": {
        "items": {
          "$ref": "#/$defs/CriterionScore"
        },
        "title": "Scores",
        "type": "array"
      },
      "total": {
        "default": 0.0,
        "description": "Weighted score, 0–1.",
        "title": "Total",
        "type": "number"
      },
      "passed": {
        "default": false,
        "title": "Passed",
        "type": "boolean"
      },
      "notes": {
        "default": "",
        "title": "Notes",
        "type": "string"
      },
      "usage": {
        "anyOf": [
          {
            "$ref": "#/$defs/Usage"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Tokens and cost when a model judged; null otherwise."
      }
    },
    "title": "Output",
    "type": "object"
  }
}
